<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 GPS Tools"
            android:textColor="#00FF88"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Photo GPS Organizer &amp; Auto-Tagger"
            android:textColor="#888899"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingBottom="12dp" />

        <!-- Format badges -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="JPG" android:textColor="#00FF88" android:background="@drawable/badge_bg"
                android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:textSize="11sp"
                android:layout_marginEnd="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="PNG" android:textColor="#00FF88" android:background="@drawable/badge_bg"
                android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:textSize="11sp"
                android:layout_marginEnd="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="HEIC" android:textColor="#00FF88" android:background="@drawable/badge_bg"
                android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:textSize="11sp"
                android:layout_marginEnd="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="DNG" android:textColor="#00FF88" android:background="@drawable/badge_bg"
                android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:textSize="11sp"
                android:layout_marginEnd="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="MP4" android:textColor="#AAAAFF" android:background="@drawable/badge_bg_blue"
                android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:textSize="11sp"
                android:layout_marginEnd="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="M4V" android:textColor="#AAAAFF" android:background="@drawable/badge_bg_blue"
                android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:textSize="11sp"/>
        </LinearLayout>

        <!-- Source Folder -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SOURCE FOLDER"
            android:textColor="#00FF88"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <EditText
            android:id="@+id/etSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="/storage/emulated/0/DCIM/AllPhotos"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:background="@drawable/input_bg"
            android:padding="10dp"
            android:inputType="text"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <!-- Destination Folder -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DESTINATION FOLDER (no GPS files go here)"
            android:textColor="#00FF88"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <EditText
            android:id="@+id/etDest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="/storage/emulated/0/NoLocation"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:background="@drawable/input_bg"
            android:padding="10dp"
            android:inputType="text"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <!-- Time Window -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TIME WINDOW FOR AUTO-TAGGING"
            android:textColor="#00FF88"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerTime"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/input_bg"
            android:paddingStart="10dp"
            android:layout_marginBottom="16dp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="▶ START PROCESS"
                android:textColor="#0A0A1A"
                android:backgroundTint="#00FF88"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="■ STOP"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF4444"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/btnExportCsv"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📊 EXPORT CSV REPORT"
            android:textColor="#0A0A1A"
            android:backgroundTint="#FFAA00"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progressTint="#00FF88"
            android:progressBackgroundTint="#1A1A2E"
            android:max="100"
            android:progress="0"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready to process files"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- Stats 4-box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                android:background="@drawable/stat_bg" android:padding="8dp" android:layout_marginEnd="4dp">
                <TextView android:id="@+id/tvTotal" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="TOTAL" android:textColor="#888899" android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                android:background="@drawable/stat_bg" android:padding="8dp" android:layout_marginEnd="4dp">
                <TextView android:id="@+id/tvMoved" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="#FF6666" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="MOVED" android:textColor="#888899" android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                android:background="@drawable/stat_bg" android:padding="8dp" android:layout_marginEnd="4dp">
                <TextView android:id="@+id/tvKept" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="#00FF88" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="KEPT" android:textColor="#888899" android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                android:background="@drawable/stat_bg" android:padding="8dp">
                <TextView android:id="@+id/tvAutoTagged" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="#AAAAFF" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="TAGGED" android:textColor="#888899" android:textSize="10sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Log -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LIVE LOG"
            android:textColor="#00FF88"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <ScrollView
            android:id="@+id/scrollLog"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="@drawable/log_bg"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="[Ready]\n"
                android:textColor="#CCCCCC"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </ScrollView>

        <View android:layout_width="match_parent" android:layout_height="16dp" />

    </LinearLayout>
</ScrollView>
